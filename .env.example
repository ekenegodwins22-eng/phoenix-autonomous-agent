# PHOENIX AI ROUTER (custom FastAPI API)
PRIMARY_BASE_URL=https://concerned-swordfish-suhailtechlnfo-01fd2de0.koyeb.app
PRIMARY_API_KEY=
# Live model discovery uses GET /available-models; chat uses POST /chat and X-API-Key.
PRIMARY_MODEL=
PRIMARY_TIMEOUT_SECONDS=60

# GOOGLE GEMINI FALLBACK (optional but recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro
GEMINI_TIMEOUT_SECONDS=45

# APP AUTH: change this to a long random secret before deploying
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_HOURS=168

# SQLite path. On hosts with ephemeral disks, use a persistent disk or Postgres-backed storage before relying on saved accounts.
DATABASE_PATH=./data/phoenix.db
APP_URL=https://YOUR-DEPLOYED-URL
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
TASK_TIMEOUT_SECONDS=300
MAX_AGENT_STEPS=20
MAX_TASK_HISTORY=100

# TempNest / Gmail alias API. If it requires bearer auth, set the token.
MAILBOX_API_BASE_URL=https://gmail-alias-api.senseiphoenix.name.ng
MAILBOX_API_TOKEN=
MAILBOX_API_COOKIE=
MAILBOX_TIMEOUT_SECONDS=20

BROWSER_HEADLESS=true
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_ACTION_TIMEOUT_MS=10000
BROWSER_CLOSE_TIMEOUT_SECONDS=8
